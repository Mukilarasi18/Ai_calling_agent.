# --- Required for the text demo (demo/text_demo.py) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-6

# --- Additional keys required only for the real phone-call pipeline (app.py) ---

# Twilio: buy/use a trial number at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Deepgram: streaming speech-to-text, https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs: text-to-speech, https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_chosen_voice_id

# Public base URL Twilio will use to reach your server (e.g. your ngrok URL)
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Where the company employee should receive summaries (used as a stub for now)
SUMMARY_NOTIFY_EMAIL=team@yourcompany.com
